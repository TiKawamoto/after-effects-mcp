{
  "name": "after-effects-mcp",
  "version": "2.0.0",
  "description": "MCP server for Adobe After Effects",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && node --test tests/*.test.mjs",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "bridge-reset": "node scripts/reset-bridge.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "acorn": "^8.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
